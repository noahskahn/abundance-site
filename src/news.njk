---
layout: base.njk
title: News & Updates
permalink: "/news-updates/index.html"
description: News and updates from the Abundance Foundation and its partners.
---
{%- from "icons.njk" import icon -%}
{% set ph = { title: "News & Updates", eyebrow: "Stories from the network", color: "teal" } %}
{% include "pagehead.njk" %}
<section class="wrap news-page">
  <h2 class="h-section">Featured</h2>
  <div class="cards cards-2">
    {% for p in hub.newsFeatured %}
    <article class="card card-wide">
      {% if p.image %}<a class="card-img" href="{{ p.path }}" tabindex="-1" aria-hidden="true"><img src="{{ p.image }}" alt="" loading="lazy"></a>{% endif %}
      <div class="card-body">
        <p class="tag">{{ p.categoryLabel }}</p>
        <h3><a href="{{ p.path }}">{{ p.title }}</a></h3>
        <p>{{ p.excerptLong }}</p>
        <a class="more" href="{{ p.path }}">Read more {{ icon("arrow", 18) }}</a>
      </div>
    </article>
    {% endfor %}
  </div>

  <h2 class="h-section all-h">All News &amp; Updates</h2>
  <ul class="news-index">
    {% for p in hub.news %}
    <li>
      <a class="thumb" href="{{ p.path }}" tabindex="-1" aria-hidden="true">{% if p.image %}<img src="{{ p.image }}" alt="" loading="lazy">{% else %}<span class="thumb-ph">{{ icon("globe", 40) }}</span>{% endif %}</a>
      <div>
        <p class="tag">{{ p.categoryLabel }}</p>
        <h3><a href="{{ p.path }}">{{ p.title }}</a></h3>
        <p>{{ p.excerpt }}</p>
      </div>
    </li>
    {% endfor %}
  </ul>
</section>
