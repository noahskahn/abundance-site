---
layout: base.njk
pagination:
  data: hub.areas
  size: 1
  alias: area
permalink: "{{ area.path }}index.html"
eleventyComputed:
  title: "{{ area.name }}"
  description: "{{ area.introText }}"
---
{%- from "icons.njk" import icon -%}
{% set ph = { title: area.name, eyebrow: "Our work", image: area.hero, color: area.color } %}
{% include "pagehead.njk" %}
<section class="wrap area-intro">
  <div class="lead-big">{{ area.intro | safe }}</div>
  <aside class="area-switch" aria-label="Impact areas">
    {% for a in hub.areas %}<a href="{{ a.path }}"{% if a.slug == area.slug %} aria-current="page"{% endif %} class="chip chip-{{ a.color }}">{{ a.name }}</a>{% endfor %}
  </aside>
</section>
<section class="wrap" aria-labelledby="proj-h">
  <h2 id="proj-h" class="h-section">Projects</h2>
  {% macro card(p, area) %}
    <article class="card tone-{{ area.color }}">
      <a class="card-img{% if 'placeholder' in p.thumb %} is-placeholder{% endif %}" href="{{ p.href }}" tabindex="-1" aria-hidden="true">{% if p.thumb %}<img src="{{ p.thumb }}" alt="" loading="lazy">{% endif %}</a>
      <div class="card-body">
        {% if p.funder %}<p class="tag"><span class="funder">{{ p.funder }}</span></p>{% endif %}
        <h3><a href="{{ p.href }}">{{ p.title }}</a></h3>
        <p>{{ p.summary }}{% if not p.summary.endsWith('.') %}…{% endif %}</p>
        <a class="more" href="{{ p.href }}">Read more</a>
      </div>
    </article>
  {% endmacro %}
  <div class="cards cards-3">
    {% for p in area.projects %}{% if not p.group %}{{ card(p, area) }}{% endif %}{% endfor %}
  </div>
  {% for g in area.groups %}
  <h3 class="h-sub">{{ g }}</h3>
  <div class="cards cards-3">
    {% for p in area.projects %}{% if p.group == g %}{{ card(p, area) }}{% endif %}{% endfor %}
  </div>
  {% endfor %}
  <p class="area-links">
    {% if area.haf.length %}Some {{ area.name }} projects are funded through the <a href="/harvard-abundance-fund/">Harvard Abundance Fund</a>. {% endif %}
    {% if area.past.length %}See <a href="/archive/#past-{{ area.slug }}">past {{ area.name }} projects</a>.{% endif %}
  </p>
</section>
<section class="area-donate wrap">
  <div class="callout tone-{{ area.color }}">
    <div><h2>Support our work</h2><p>100% of your gift goes to programs and partners.</p></div>
    <a class="btn btn-donate" href="/donate/">Donate</a>
  </div>
</section>
