{# Two-tone line icons: a navy outline with one brand-colour accent, drawn on a 64px grid. #}
{% macro icon(name, size=64) %}
{% set vb = 64 if name in ["health","empowerment","arts-education","globe","hands"] else 24 %}
<svg class="icon icon-{{ name }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 {{ vb }} {{ vb }}" fill="none" aria-hidden="true" focusable="false">
{% if name == "health" %}
  <path class="a" d="M32 54C16 43 8 34.5 8 24.5 8 17.6 13.4 12 20 12c4.7 0 9 2.6 12 7 3-4.4 7.3-7 12-7 6.6 0 12 5.600 12 12.500C56 34.500 48 43 32 54Z" stroke-width="3" stroke-linejoin="round"/>
  <path class="b" d="M32 24v16M24 32h16" stroke-width="4" stroke-linecap="round"/>
{% elif name == "empowerment" %}
  <path class="a" d="M32 56V30" stroke-width="3" stroke-linecap="round"/>
  <path class="a" d="M32 36C32 26 24 20 12 20c0 10 8 16 20 16Z" stroke-width="3" stroke-linejoin="round"/>
  <path class="b" d="M32 28c0-10 8-16 20-16 0 10-8 16-20 16Z" stroke-width="3" stroke-linejoin="round"/>
  <path class="a" d="M20 56h24" stroke-width="3" stroke-linecap="round"/>
{% elif name == "arts-education" %}
  <path class="a" d="M8 14c8-2 16-1 24 4v36c-8-5-16-6-24-4V14ZM56 14c-8-2-16-1-24 4v36c8-5 16-6 24-4V14Z" stroke-width="3" stroke-linejoin="round"/>
  <path class="b" d="m44 8 2.600 5.400L52 16l-5.400 2.600L44 24l-2.600-5.400L36 16l5.400-2.600L44 8Z" stroke-width="2.600" stroke-linejoin="round"/>
{% elif name == "globe" %}
  <circle class="a" cx="32" cy="32" r="22" stroke-width="3"/>
  <path class="b" d="M10 32h44M32 10c-8 6-10 14-10 22s2 16 10 22c8-6 10-14 10-22S40 16 32 10Z" stroke-width="3" stroke-linejoin="round"/>
{% elif name == "hands" %}
  <path class="a" d="M8 36l10-10 8 3 8-6 8 5 6-4 8 8-14 16-8-3-6 4-8-7-12-6Z" stroke-width="3" stroke-linejoin="round"/>
  <path class="b" d="M26 29l10 8" stroke-width="3" stroke-linecap="round"/>
{% elif name == "arrow" %}
  <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round"/>
{% elif name == "play" %}
  <path d="M8 5v14l11-7L8 5Z" fill="currentColor"/>
{% elif name == "heart" %}
  <path d="M12 20.500C5 15.500 2.500 11.800 2.500 8.500 2.500 6 4.500 4 7 4c2 0 3.800 1 5 3 1.200-2 3-3 5-3 2.500 0 4.500 2 4.500 4.500 0 3.300-2.500 7-9.500 12Z" fill="currentColor"/>
{% elif name == "chevron" %}
  <path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="2.200" stroke-linecap="round" stroke-linejoin="round"/>
{% elif name == "menu" %}
  <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.200" stroke-linecap="round"/>
{% elif name == "search" %}
  <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="2.2"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
{% elif name == "close" %}
  <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="2.200" stroke-linecap="round"/>
{% endif %}
</svg>
{% endmacro %}
